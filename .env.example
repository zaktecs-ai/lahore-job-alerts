# Gmail account jo EMAIL BHEJEGA (sender)
GMAIL_USER=ranazak73@gmail.com

# Gmail 16-character APP PASSWORD (spaces remove kar dein)
# Google Account > Security > 2-Step Verification > App passwords
GMAIL_APP_PASSWORD=your-16-char-app-password-goes-here

# KIS KO EMAIL jaye (receiver)
GMAIL_TO=zakriarajpoot73@gmail.com

# Gmail SMTP (defaults bilkul theek hain — change na karein)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Optional: logs console par kitna detail dikhana hai
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO